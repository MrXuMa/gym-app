!supabase/migrations/**
!supabase/functions/
supabase/functions/*
!supabase/functions/analyze-food/
supabase/functions/analyze-food/*
!supabase/functions/analyze-food/index.ts
!supabase/functions/search-food/
supabase/functions/search-food/*
!supabase/functions/search-food/index.ts

